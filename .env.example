# =========================================================
# MedIntel-AI - Configuration Variables
# =========================================================

# Configuration Ollama (100% Local)
# Le nom du modèle que vous avez téléchargé avec 'ollama pull'
OLLAMA_MODEL=qwen2.5:7b

# URL de votre serveur Qdrant (Docker)
QDRANT_URL=http://localhost:6333

# Nom de la collection dans Qdrant
COLLECTION_NAME=medical_articles

# Modèle d'embeddings (pour la recherche sémantique)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# (Optionnel) Si vous aviez une clé API externe, elle irait ici
# GEMINI_API_KEY=